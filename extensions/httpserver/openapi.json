                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "openapi",
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "An error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "RuntimeState": {
        "type": "string",
        "enum": [
          "ready",
          "running",
          "waiting",
          "cancel_requested",
          "finalizing",
          "needs_attention",
          "terminal"
        ]
      },
      "Definition": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        }
      },
      "SubmitRequest": {
        "type": "object",
        "required": [
          "definition",
          "task"
        ],
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/Definition"
          },
          "task": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "idempotency_scope": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "conversation": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "expected_head": {
                "type": "string",
                "description": "Run ID of the turn this continues; empty starts the conversation."
              }
            }
          }
        }
      },
      "ResolveWaitRequest": {
        "type": "object",
        "properties": {
          "answer": {
            "description": "A question's answer (any JSON)."
          },
          "decision": {
            "type": "string",
            "enum": [
              "allow",
              "deny"
            ]
          },
          "reason": {
            "type": "string"
          },
          "action_digest": {
            "type": "string",
            "description": "Required with an approval decision."
          }
        }
      },
      "ReconcileRequest": {
        "type": "object",
        "required": [
          "result",
          "effect"
        ],
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "is_error": {
                "type": "boolean"
              }
            }
          },
          "effect": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "none",
                  "applied",
                  "not_applied"
                ]
              },
              "receipt": {
                "type": "string"
              }
            }
          }
        }
      },
      "Run": {
        "type": "object",
        "required": [
          "run_id",
          "definition",
          "state"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "definition": {
            "$ref": "#/components/schemas/Definition"
          },
          "state": {
            "$ref": "#/components/schemas/RuntimeState"
          },
          "status": {
            "type": "string"
          },
          "attention": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "blocking_run_id": {
                "type": "string"
              }
            }
          },
          "failure": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "stop_reason": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "parent": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string"
              },
              "operation_id": {
                "type": "string"
              }
            }
          },
          "conversation": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            }
          },
          "idempotency_key": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "event_sequence": {
            "type": "integer"
          },
          "turns": {
            "type": "integer"
          },
          "usage": {
            "type": "object"
          },
          "tree_runs": {
